---
const today = new Date();
---

<footer>
	<div class="inner">
		<p class="copy">&copy; {today.getFullYear()} Demgainschill. All rights reserved.</p>
	<nav class="links">
		<a href="/">Home</a>
		<a href="/blog">Blog</a>
		<a href="/about">About</a>
		<a href="https://github.com/Demgainschill" target="_blank" rel="noopener noreferrer">GitHub</a>
		<a href="/rss.xml">RSS</a>
	</nav>	
	
	</div>
</footer>

<style>
	footer {
	border-top: 1px solid #d7d4ce;
	background: #eceae6;
	color: #5a5854;
}
.inner {
	width: min(720px, calc(100% - 2.5rem));
	margin: 0 auto;
	padding: 2rem 0 2.75rem;
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 1rem;
	flex-wrap: wrap;
}
.copy {
	margin: 0;
	font-size: 0.88rem;
	color: #5a5854;
}
.links {
	display: flex;
	gap: 1.15rem;
}
.links a {
	font-size: 0.88rem;
	color: #4f4d49;
	text-decoration: none;
}
.links a:hover {
	color: #1c1b19;
	text-decoration: underline;
	text-underline-offset: 3px;
}
</style>
