---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

// Swap this one import to change the circle image.
import portrait from '../assets/about-desk.jpg';

const title = 'About · Demgainschill';
const description =
	'Operator notes on Linux systems, offensive security, and the work that is worth keeping.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="about">
		<Header />
		<main>
			<div class="layout">
				<aside class="rail">
					<div class="rail-card">
						<div class="avatar">
							<img
								src={typeof portrait === 'object' ? portrait.src : portrait}
								width={typeof portrait === 'object' ? portrait.width : 400}
								height={typeof portrait === 'object' ? portrait.height : 400}
								alt="Demgainschill"
							/>
						</div>
						<p class="who">Demgainschill</p>
						<p class="where">Bengaluru</p>
						<ul class="meta">
							<li>Linux</li>
							<li>Offensive security</li>
							<li>RHCSA · RHCE</li>
						</ul>
						<nav class="rail-links">
							<a href="/blog">Notes</a>
							<a
								href="https://github.com/Demgainschill"
								target="_blank"
								rel="noopener noreferrer">GitHub</a
							>
						</nav>
					</div>
				</aside>

				<article class="copy">
					<p class="eyebrow">About</p>
					<h1>About me</h1>
					<p class="lede">
						I write as Demgainschill. The blog is the public desk for
						systems notes, lab writeups, interesting tools a completely Linux first all that i believe is useful and will help the community to help solve problems. Learn. Build. Automate. 
					</p>

					<section>
						<h2>Now</h2>
						<p>
							I work through Linux systems and offensive security the slow
							way: build the lab, break the assumption, write down what
							actually happened. RHCSA and RHCE are done. CPTS and OSCP are
							the current arc practice first, certificate second.
						</p>
						<p>
							Most days that looks like recon that does not lie, Active
							Directory paths that hold up under a second look, and tooling
							I will still want six months from now.
						</p>
					</section>

					<section>
						<h2>On the bench</h2>
						<ul class="work">
							<li>
								<a
									href="https://github.com/Demgainschill/compdiff"
									target="_blank"
									rel="noopener noreferrer"
								>
									<span class="name">Compdiff</span>
									<span class="hint"
										>Masscan + Nmap rounds that separate confirmed,
										new, flapping, and scan-only ports.</span
									>
								</a>
							</li>
							<li>
								<a
									href="https://github.com/Demgainschill/JWTack"
									target="_blank"
									rel="noopener noreferrer"
								>
									<span class="name">JWTack</span>
									<span class="hint">A small JWT exploitation kit. Sharp edges labelled.</span>
								</a>
							</li>
							<li>
								<a
									href="https://github.com/Demgainschill"
									target="_blank"
									rel="noopener noreferrer"
								>
									<span class="name">Lab notes</span>
									<span class="hint">HTB and homelab writeups. Method over flags.</span>
								</a>
							</li>
						</ul>
					</section>

					<section>
						<h2>This site</h2>
						<p>
							Home is the index. Blog is the record. About is the context so
							a stranger does not have to guess.
						</p>
					</section>
				</article>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about {
		background: #f4f1ea;
		color: #2b2925;
	}
	main {
		width: min(860px, calc(100% - 2.5rem));
		margin: 0 auto;
		padding: 3.5rem 0 5rem;
	}
	.layout {
		display: grid;
		grid-template-columns: 13.25rem minmax(0, 1fr);
		gap: 2.75rem;
		align-items: start;
	}

	.rail {
		position: sticky;
		top: 5.25rem;
	}
	.rail-card {
		padding: 1.15rem 1rem 1.25rem;
		border: 1px solid #e2ddd3;
		border-radius: 1.15rem;
		background: rgba(250, 248, 244, 0.55);
		backdrop-filter: blur(14px) saturate(1.05);
		-webkit-backdrop-filter: blur(14px) saturate(1.05);
		box-shadow: 0 10px 28px rgba(43, 41, 37, 0.04);
		text-align: center;
	}
	.avatar {
		width: 7.25rem;
		height: 7.25rem;
		margin: 0.15rem auto 0.95rem;
		border-radius: 50%;
		overflow: hidden;
		border: 1px solid #d9d3c8;
		box-shadow:
			0 0 0 6px rgba(244, 241, 234, 0.7),
			0 8px 20px rgba(43, 41, 37, 0.08);
		background: #efebe3;
	}
	.avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 30% 45%;
		filter: saturate(0.82) contrast(0.96);
		display: block;
	}
	.who {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: #1f1d1a;
	}
	.where {
		margin: 0.2rem 0 0.85rem;
		font-size: 0.82rem;
		color: #8a857c;
	}
	.meta {
		list-style: none;
		margin: 0;
		padding: 0.75rem 0;
		border-top: 1px solid #e2ddd3;
		border-bottom: 1px solid #e2ddd3;
	}
	.meta li {
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #7a756c;
		line-height: 1.7;
	}
	.rail-links {
		display: flex;
		justify-content: center;
		gap: 0.85rem;
		margin-top: 0.9rem;
	}
	.rail-links a {
		font-size: 0.86rem;
		color: #5c5850;
		text-decoration: none;
	}
	.rail-links a:hover {
		color: #1f1d1a;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.copy {
		min-width: 0;
		padding-top: 0.15rem;
	}
	.eyebrow {
		margin: 0 0 0.85rem;
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #7a756c;
	}
	h1 {
		margin: 0;
		font-size: clamp(2rem, 4vw, 2.7rem);
		line-height: 1.12;
		font-weight: 600;
		letter-spacing: -0.03em;
		color: #1f1d1a;
	}
	.lede {
		margin: 1.1rem 0 0;
		font-size: 1.06rem;
		line-height: 1.7;
		color: #5c5850;
	}
	.copy section {
		margin-top: 2rem;
		padding-top: 1.65rem;
		border-top: 1px solid #e2ddd3;
	}
	.copy h2 {
		margin: 0 0 0.85rem;
		font-size: 0.8rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: #7a756c;
		font-weight: 600;
	}
	.copy p {
		margin: 0 0 0.9rem;
		font-size: 1.02rem;
		line-height: 1.72;
		color: #5c5850;
	}
	.copy p:last-child {
		margin-bottom: 0;
	}

	.work {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.work li + li {
		border-top: 1px solid #e2ddd3;
	}
	.work a {
		display: grid;
		gap: 0.2rem;
		padding: 0.95rem 0;
		text-decoration: none;
		color: inherit;
	}
	.work .name {
		font-weight: 600;
		color: #1f1d1a;
	}
	.work .hint {
		font-size: 0.92rem;
		color: #6a665e;
		line-height: 1.5;
	}
	.work a:hover .name {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (max-width: 720px) {
		.layout {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}
		.rail {
			position: static;
		}
		.rail-card {
			display: grid;
			grid-template-columns: 5.5rem 1fr;
			grid-template-areas:
				"pic who"
				"pic where"
				"meta meta"
				"links links";
			gap: 0.15rem 1rem;
			text-align: left;
			align-items: center;
		}
		.avatar {
			grid-area: pic;
			width: 5.5rem;
			height: 5.5rem;
			margin: 0;
		}
		.who {
			grid-area: who;
			align-self: end;
		}
		.where {
			grid-area: where;
			margin: 0;
			align-self: start;
		}
		.meta {
			grid-area: meta;
			display: flex;
			flex-wrap: wrap;
			gap: 0.35rem 0.9rem;
			padding: 0.7rem 0 0.55rem;
			border-bottom: 0;
		}
		.rail-links {
			grid-area: links;
			justify-content: flex-start;
			margin-top: 0;
		}
	}
</style>
